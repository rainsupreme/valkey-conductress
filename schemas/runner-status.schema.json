{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conductress.dev/schemas/runner-status-v1.json",
  "title": "Conductress runner status",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "timestamp", "runner_id", "platform", "identity", "runner", "queue"],
  "properties": {
    "schema_version": {"const": 1},
    "timestamp": {"type": "string", "format": "date-time"},
    "runner_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"},
    "platform": {"type": "string", "minLength": 1},
    "identity": {"type": "object"},
    "host": {"type": "string"},
    "runner": {"type": "object"},
    "current_task": {"type": ["object", "null"]},
    "queue": {
      "type": "object",
      "required": ["depth", "tasks"],
      "properties": {
        "depth": {"type": "integer", "minimum": 0},
        "tasks": {"type": "array"}
      }
    },
    "recent_results": {"type": "array"},
    "disk": {"type": "object"},
    "eta_minutes": {"type": "number", "minimum": 0}
  }
}
