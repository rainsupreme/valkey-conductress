{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conductress.dev/schemas/task-outcome-v1.json",
  "title": "Conductress task outcome",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "runner_id", "state", "completed_at"],
  "properties": {
    "schema_version": {"const": 1},
    "task_id": {"type": "string", "minLength": 1},
    "runner_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"},
    "state": {"enum": ["completed", "failed"]},
    "completed_at": {"type": "string", "format": "date-time"},
    "result": {"type": ["object", "null"]},
    "error": {"type": ["string", "null"]}
  }
}
