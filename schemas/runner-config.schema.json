{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conductress.dev/schemas/runner-config-v1.json",
  "title": "Conductress local runner configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "runner_id"],
  "properties": {
    "schema_version": {"const": 1},
    "runner_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"},
    "display_name": {"type": "string", "minLength": 1}
  }
}
