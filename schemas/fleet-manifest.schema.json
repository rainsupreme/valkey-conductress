{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conductress.dev/schemas/fleet-manifest-v1.json",
  "title": "Conductress fleet manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "runners"],
  "properties": {
    "schema_version": {"const": 1},
    "runners": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["runner_id", "display_name", "platform", "platform_aliases", "enabled"],
        "properties": {
          "runner_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"},
          "display_name": {"type": "string", "minLength": 1},
          "platform": {"type": "string", "minLength": 1},
          "platform_aliases": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "enabled": {"type": "boolean"},
          "canary_profile": {"type": ["string", "null"]},
          "status_ttl_seconds": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
